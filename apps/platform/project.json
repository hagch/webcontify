{
  "name": "platform",
  "root": "apps/platform",
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm next dev --port 3000",
        "cwd": "apps/platform"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm next build",
        "cwd": "apps/platform"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm eslint",
        "cwd": "apps/platform"
      }
    },
    "generate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm generate",
        "cwd": "apps/platform"
      }
    }
  }
}
