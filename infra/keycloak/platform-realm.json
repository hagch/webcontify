{
  "id": "webcontify-platform",
  "realm": "webcontify-platform",
  "displayName": "Webcontify Platform",
  "enabled": true,
  "loginTheme": "keycloak",
  "accountTheme": "keycloak.v3",
  "adminTheme": "keycloak.v2",
  "emailTheme": "keycloak",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "accessTokenLifespan": 300,
  "ssoSessionMaxLifespan": 1800,
  "offlineSessionMaxLifespanEnabled": false,
  "roles": {
    "realm": [
      {
        "name": "PLATFORM_ADMIN",
        "description": "Plattform-Administrator mit vollem Zugriff auf alle Tenant-Verwaltungsfunktionen",
        "composite": false,
        "clientRole": false
      }
    ]
  },
  "clients": [
    {
      "clientId": "platform-ui",
      "name": "Platform UI",
      "description": "Webcontify Platform Management UI",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "authorizationServicesEnabled": false,
      "fullScopeAllowed": true,
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://platform.localhost/*##http://localhost:3000/*"
      },
      "redirectUris": [
        "http://platform.localhost/*",
        "http://localhost:3000/*"
      ],
      "webOrigins": [
        "http://platform.localhost",
        "http://localhost:3000"
      ],
      "protocolMappers": [
        {
          "name": "tenant_id-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "false",
            "user.attribute": "tenant_id",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "multivalued": "false",
            "aggregate.attrs": "false"
          }
        }
      ],
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "roles",
        "profile",
        "basic",
        "email"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access",
        "microprofile-jwt"
      ]
    },
    {
      "clientId": "platform-backend",
      "name": "Platform Backend Service Account",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "platform-backend-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "publicClient": false,
      "protocol": "openid-connect"
    }
  ],
  "users": [
    {
      "username": "admin",
      "email": "admin@webcontify.io",
      "firstName": "Platform",
      "lastName": "Admin",
      "emailVerified": true,
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "admin",
          "temporary": false
        }
      ],
      "realmRoles": [
        "PLATFORM_ADMIN",
        "default-roles-webcontify-platform"
      ]
    },
    {
      "username": "tenant-user",
      "email": "user@demo-tenant.webcontify.io",
      "firstName": "Tenant",
      "lastName": "User",
      "emailVerified": true,
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "user",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-webcontify-platform"
      ],
      "attributes": {
        "tenant_id": [
          "00000000-0000-0000-0000-000000000001"
        ]
      }
    }
  ]
}
