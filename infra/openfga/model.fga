model
  schema 1.1

type user

type platform
  relations
    define admin: [user]

type tenant
  relations
    define admin: [user]
    define member: [user] or admin

type role
  relations
    define tenant: [tenant]
    define assignee: [user]

type user_management
  relations
    define tenant: [tenant]
    define inviter: [user, role#assignee] or admin from tenant
    define editor: [user, role#assignee] or admin from tenant
    define deleter: [user, role#assignee] or admin from tenant
    define reader: [user, role#assignee] or editor or inviter or deleter or admin from tenant

type role_management
  relations
    define tenant: [tenant]
    define creator: [user, role#assignee] or admin from tenant
    define editor: [user, role#assignee] or admin from tenant
    define deleter: [user, role#assignee] or admin from tenant
    define reader: [user, role#assignee] or editor or creator or deleter or admin from tenant

type tenant_config
  relations
    define tenant: [tenant]
    define editor: [user, role#assignee] or admin from tenant
    define reader: [user, role#assignee] or editor or admin from tenant

type app_management
  relations
    define tenant: [tenant]
    define admin: [user, role#assignee] or admin from tenant
    define editor: [user, role#assignee] or admin
    define creator: [user, role#assignee] or admin
    define viewer: [user, role#assignee] or editor or creator

type app
  relations
    define management: [app_management]
    define restricted: [user, role#assignee]
    define viewer: [user, role#assignee] or viewer from management
    define editor: [user, role#assignee] or editor from management
    define admin: [user, role#assignee] or admin from management

type content_definition
  relations
    define parent: [app]
    define viewer: [user, role#assignee] or (viewer from parent but not restricted from parent)
    define editor: [user, role#assignee] or (editor from parent but not restricted from parent)
    define deleter: [user, role#assignee] or (editor from parent but not restricted from parent)
